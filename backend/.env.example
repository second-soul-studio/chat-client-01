# Comma-separated list of upstream base URLs the proxy is permitted to forward to.
# Requests with an X-Target-URL not in this list are rejected with 403.
ALLOWED_UPSTREAM_URLS=https://ollama.com,https://api.search.brave.com

# Comma-separated list of browser Origins allowed to use this proxy.
# The browser sets the Origin header automatically — JavaScript cannot override it.
# Leave empty to disable the Origin check (less strict, fine for local deployments).
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Port the proxy listens on (default: 8080).
PORT=8080
